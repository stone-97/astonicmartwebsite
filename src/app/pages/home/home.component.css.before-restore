.carousel2-container {
  overflow: hidden;
  width: 100%;
  background: #fff;
  padding: 20px 0;
}

.carousel2-track {
  display: flex;
  gap: 20px;

  width: max-content;

  animation: carousel2-scroll 35s linear infinite;
}




@keyframes carousel2-scroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-5980px);
  }
}

.carousel2-card {
  position: relative;

  width: 280px;
  min-width: 280px;

  background: linear-gradient(to bottom, #ffffff, #f8fafc);

  border: 1px solid rgba(4, 30, 56, 0.08);
  border-radius: 18px;

  padding: 14px;

  text-align: left;

  box-shadow:
    0 6px 18px rgba(0, 0, 0, 0.08),
    0 2px 6px rgba(0, 0, 0, 0.04);

  transition:
    transform .35s ease,
    box-shadow .35s ease,
    border-color .35s ease;

  overflow: hidden;
}


.carousel2-ribbon {
  position: absolute;
  top: 10px;
  left: -5px;
  background: red;
  color: #fff;
  padding: 3px 5px;
  font-size: 12px;
  font-weight: bold;
  border-radius: 0 5px 5px 0;
  z-index: 5;              /* stays above images even on hover */
}

/* Image row: main on the left, extras stacked on the right */
/* IMAGE LAYOUT */
.carousel2-image {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

/* main image */
.carousel2-main {
  width: 100%;
  height: 100%;

  object-fit: contain;

  transition: transform .3s ease;
}
/* hover effect */
.carousel2-main-container:hover {
  border-color: rgba(255, 186, 0, 0.3);

  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
}

.carousel2-main-container:hover .carousel2-main {
  transform: scale(1.05);
}
/* EXTRA IMAGES COLUMN */
.carousel2-extra {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* extra image boxes */
.carousel2-extra img {
  width: 58px;
  height: 58px;

  object-fit: contain;

  background: #f8fafc;

  border: 1px solid rgba(4, 30, 56, 0.08);

  border-radius: 10px;

  padding: 5px;

  cursor: pointer;

  transition: all .3s ease;
}

/* hover */
.carousel2-extra img:hover {
  transform: scale(1.08);

  border-color: rgba(255, 186, 0, 0.4);

  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.1);
}

/* little click hint */
.carousel2-extra {
  position: relative;
}

/* top glow line */
.carousel2-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;

  width: 100%;
  height: 4px;

  background: linear-gradient(90deg, #041e38, #ffba00);
}

/* Hover animations (both main and extra images) */
.carousel2-main:hover,
.carousel2-extra img:hover {
  transform: scale(1.08);
  z-index: 2;
}

/* Product details */
.carousel2-details { margin-top: 10px; }

.carousel2-name {
  font-size: 15px;
  font-weight: 600;
  color: #2f4858;

  text-align: center;

  margin-bottom: 10px;

  line-height: 1.4;

  min-height: 42px;
/* price row */
.carousel2-price {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  margin-bottom: 8px;
}



/* hover effect */
.carousel2-card:hover {
  transform: translateY(-10px);

  border-color: rgba(255, 186, 0, 0.45);

  box-shadow:
    0 18px 35px rgba(0, 0, 0, 0.14),
    0 6px 12px rgba(0, 0, 0, 0.08);

}

/* selling price */
.carousel2-actual {
  font-size: 18px;
