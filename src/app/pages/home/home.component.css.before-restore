/* Image container */
.img-wrapper {
  width: 100%;
  height: 260px;
  overflow: hidden;
  border-radius: 10px;
  position: relative;

  background: #ffffff;
  border: 2px solid rgba(0, 0, 0, 0.12);
  box-shadow: 0 5px 14px rgba(0,0,0,0.18);
  padding: 8px;

  transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.3s ease;
}

/* ASH COLOR BOTTOM AREA */
.img-wrapper::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 20px;             /* height of the ash strip */
  background: #e9e9e9;      /* soft ash color */
  opacity: 0.9;             /* not too bright */
  border-bottom-left-radius: 10px;
  border-bottom-right-radius: 10px;
  z-index: 1;
}

/* Make sure the logo tag stays ABOVE the ash color */
.brand-tag {
  position: absolute;
  bottom: 15px;
  right: 15px;
  z-index: 10;
}

/* Product image */
.img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.5s ease, filter 0.5s ease;
  display: block;
}

/* Hover animation */
.img-wrapper:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.25);
  border-color: #041e38;
}

.img-wrapper:hover img {
  transform: scale(1.06);
  filter: brightness(1.08);
}


