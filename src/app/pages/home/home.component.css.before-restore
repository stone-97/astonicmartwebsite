/* start section */
.stats-section .container-fluid {
  max-width: 1400px;
  margin: 0 auto;
}


/* banner begins */
/* Wrapper to control width, centering, and spacing */
.hero-banner-wrapper {
    display: flex;
    max-width: 1600px;    /* max width of the banner */
    margin: 0 auto;        /* center the wrapper */
    height: 500px;
    width: 100%;
    box-sizing: border-box;
    padding-left: 30px;    /* <-- space on the left edge */
    padding-right: 30px;   /* <-- space on the right edge */
}

.add-bag-link {
    display: inline-flex !important;
    align-items: center;
    cursor: pointer;
    z-index: 99;          /* ensures it's above other elements */
    position: relative;   /* required for z-index */
}

.add-bag-link span {
    pointer-events: none; /* ensures clicks pass through the spans to the <a> */
}

/* Left (video) and right (image) */
.hero-col {
    flex: 1;                     
    position: relative;
    padding: 0;                  
}

/* VIDEO styling */
.hero-col video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* IMAGE styling */
.hero-col img {
    width: 100%;
    height: 100%;
    object-fit: contain;         
    display: block;
    background: transparent;     
}

/* Overlay on the video side */
.banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
    color: white;
    background: rgba(0,0,0,0.3);
}

/* =========================================================
   MOBILE HERO BANNERS
   ========================================================= */

@media (max-width: 991px) {

  .hero-banner-wrapper {
    flex-direction: column !important;
    height: auto !important;
    width: 100% !important;

    padding: 0 15px !important;
    margin: 0 auto !important;

    box-sizing: border-box !important;
  }

  /* Each banner */
  .hero-col {
    position: relative !important;

    width: 100% !important;
    height: 300px !important;

    margin: 0 !important;
  }

  /* Small space between the two banners */
  .hero-col:first-child {
    margin-bottom: 10px !important;
  }

  .hero-col:last-child {
    margin-bottom: 0 !important;
  }

  /* Video */
  .hero-col video {
    display: block !important;

    width: 100% !important;
    height: 100% !important;

    object-fit: cover !important;
  }

  /* Astonic Mart image */
  .hero-col img {
    display: block !important;

    width: 100% !important;
    height: 100% !important;

    object-fit: contain !important;
  }

  /* =====================================================
     TOP-GRADE TEXT OVERLAY
     ===================================================== */

  .banner-overlay {
    position: absolute !important;

    top: 0 !important;
    left: 0 !important;

    width: 100% !important;
    height: 100% !important;

    box-sizing: border-box !important;

    padding: 28px 20px 20px !important;

    display: flex !important;
    flex-direction: column !important;

    /*
     * IMPORTANT:
     * Do NOT center the content vertically.
     * This was causing "Top-Grade" to be cut off.
     */
    justify-content: flex-start !important;

    align-items: flex-start !important;

    background: rgba(0, 0, 0, 0.30) !important;

    z-index: 2 !important;
  }

  .banner-overlay h1 {
    margin: 0 0 12px 0 !important;

    font-size: 30px !important;
    line-height: 1.15 !important;

    font-weight: 800 !important;

    color: white !important;
  }

  .banner-overlay p {
    margin: 0 0 18px 0 !important;

    max-width: 95% !important;

    font-size: 14px !important;
    line-height: 1.45 !important;

    color: white !important;
  }

  /* Shop Now */
  .banner-overlay .add-bag-link {
    margin-top: 5px !important;

    display: inline-flex !important;

    align-items: center !important;

    position: relative !important;

    z-index: 10 !important;
  }

}

