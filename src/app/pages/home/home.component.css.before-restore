/* testimonial */
/* Section */
.testi-section {
  background: #f8f9fa;
  padding: 40px 0;
}

.testi-title {
  text-align: center;
  color: #002b5c;
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 25px;
}

/* Slider wrapper */
.testi-slider {
  height: 330px;
  position: relative;
  overflow: hidden;
}

/* Groups */
.testi-group {
  display: flex;
  justify-content: center;
  gap: 20px;
  opacity: 0;
  position: absolute;
  width: 100%;
  top: 0;
  left: 0;
  animation: fadeSlide 18s infinite;
  background: #f8f9fa; /* THIS FIXES THE WHITE FLASH */
}


.testi-group:nth-child(1) { animation-delay: 0s; }
.testi-group:nth-child(2) { animation-delay: 6s; }
.testi-group:nth-child(3) { animation-delay: 12s; }

/* Cards */
.testi-card {
  background: white;
  width: 30%;
  min-width: 250px;
  padding: 15px;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  text-align: center;
}

/* Images - FIXED NOW */
.testi-card img {
  width: 100%;
  height: 120px;
  object-fit: contain;
  background: #f0f0f0;
  border-radius: 8px;
}

/* Text */
.stars { color: #f1c40f; margin-top: 5px; font-size: 14px; }
.testi-card p { font-size: 13px; font-style: italic; color: #444; min-height: 55px; }
.testi-card h4 { font-size: 14px; color: #002b5c; font-weight: 700; }

/* Animation */
@keyframes fadeSlide {
  0% { opacity: 0; }
  5% { opacity: 1; }
  30% { opacity: 1; }
  35% { opacity: 0; }
  100% { opacity: 0; }
}

/* Arrows */
.testi-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32px;
  font-weight: bold;
  cursor: pointer;
  color: #002b5c;
  padding: 5px 12px;
  background: rgba(255,255,255,0.8);
  border-radius: 50%;
  z-index: 50;
}

.testi-arrow.left { left: 15px; }
.testi-arrow.right { right: 15px; }

.testi-arrow:hover {
  background: white;
}

/* Mobile */
@media (max-width: 768px) {
  .testi-group { flex-direction: column; gap: 15px; }
  .testi-card { width: 90%; margin: auto; }
}

/* testimonials end */







