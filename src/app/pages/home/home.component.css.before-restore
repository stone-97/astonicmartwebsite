/* .logo-container */
/* Container hides overflow */
.logo-container {
  width: 100%;
  overflow: hidden;
  position: relative;
  height: 120px;
  padding-top: 20px;
  box-sizing: border-box;
}

/* Track: flex row with duplicated logos */
.logo-track {
  display: flex;
  align-items: center;
  gap: 50px;
  animation: pingpong 5s linear infinite alternate;
}

/* Logos */
.logo-track img {
  max-height: 80px;
  width: 100px;
  object-fit: contain;
}

/* Ping-Pong Animation: move left â†’ right and back */
@keyframes pingpong {
  0% {
    transform: translateX(0); /* start at beginning */
  }
  100% {
    transform: translateX(-50%); /* scroll to the end (half the track) */
  }
}

